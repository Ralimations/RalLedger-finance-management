<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.TestApplication" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/pesomind_calm_blue</item>
        <item name="colorPrimaryVariant">@color/pesomind_deep_indigo</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/pesomind_ocean_blue</item>
        <item name="colorSecondaryVariant">@color/pesomind_deep_indigo</item>
        <item name="android:windowBackground">@color/pesomind_splash_background</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.TestApplication.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pesomind_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/pesomind_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.TestApplication</item>
    </style>
</resources>
